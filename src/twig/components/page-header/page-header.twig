{% import 'macros.twig' as macros %}

{% if in_component_library %}
  {% set squiggleComponent = '@squiggle' %}
{% else %}
  {% set squiggleComponent = 'squiggle.twig' %}
{% endif %}

{% if image is defined and image %}
  {% set type = 'page-header--image' %}
{% endif %}

<component is="page-header" class="page-header {{ type|default('page-header--default') }}">
  <div class="page-header__inner grid">
    <div class="page-header__main">
      <h1 class="heading-style-1"><div class="page-header__shade"></div><span>{{ heading }}</span></h1>
      {% include squiggleComponent with { type: 'light' } %}
      {% if image is defined and image %}
        <div class="page-header__small-text">
          <div>Queens University of Charlotte</div>
          <div>Royals Rise</div>
        </div>
      {% endif %}
    </div>
  </div>
  {% if image is defined and image %}
    <div class="page-header__media">{{ macros.picture('object-cover', image.srcset, image.src, image.sizes.Hero, image.sizes.Hero_mobile, image.alt, in_component_library) }}</div>
  {% endif %}
</component>
{% if not image and breadcrumbs %}
  {% include 'breadcrumbs.twig' with {
    items: breadcrumbs_menu,
  } %}
{% endif %}