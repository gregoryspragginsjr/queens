{% import "macros.twig" as macros %}
{% import "icons.twig" as icons %}

<component
  class="video"
  v-slot="video"
  id="{{ video.id }}"
  is="video"
>
  <div
    class="video__overlay"
    :class="{'video__overlay--active': video.active == true}"
  >
    {% if playIcon != false %}
      <div class="video__btn">
        {{ icons.icon('play', 'video__svg') }}
      </div>
    {% endif %}
    {% if video_loop %}
      <video class="hidden md:block z-[1] absolute min-w-full min-h-full w-auto h-auto bg-repeat bg-cover top-0 right-0 bottom-0 left-0 object-cover" autoplay muted loop>
        <source src="{{ video_loop }}" type="video/mp4">
      </video>
    {% endif %}
    {{ macros.picture(
      'video__image object-cover',
      image.srcset,
      image.src,
      image.sizes.Hero,
      image.sizes.Hero,
      image.alt,
      in_component_library
    ) }}
  </div>
  <div class="video__iframe"></div>
</component>