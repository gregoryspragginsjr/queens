{% import 'icons.twig' as icons %}

<div class="hero">
  <div class="hero__inner grid">
    <div class="hero__main cover">
      <div class="hero__lockup centered">
        <h1 class="hero__headline display-heading-style-1">{{ heading }}</h1>
      </div>

      <div class="hero__badges">{{ icons.icon('est-badge', 'hero__est-badge') }}
        {{ icons.icon('rise-royals', 'hero__rise-royals') }}</div>

      {% if video %}
        <div class="hero__media-controls video-toggle">
          <span class="video-toggle__caption">This video has no audio</span>

          <button class="video-toggle__button">
            <span class="video-toggle__play">
              {{ icons.icon('play', 'icon icon--md fill-current') }}
              <span class="sr-only">Play</span>
            </span>
            <span class="video-toggle__pause">
              {{ icons.icon('pause', 'icon icon--md fill-current') }}
              <span class="sr-only">Pause</span>
            </span>
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  {% if video %}
    <video class="hero__media" preload="auto" playsinline autoplay loop muted>
      <source src="{{ video }}" type="video/mp4" />
    </video>
  {% endif %}
</div>
