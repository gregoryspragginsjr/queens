<div class="logo-grid">
  <div class="logo-grid__inner grid">
    <div class="logo-grid__main">
      {% for item in items %}
        <div class="logo-grid__image">
          <img src="{{ item.image.sizes.Square }}" alt="{{ item.image.alt }}" />
        </div>
      {% endfor %}
    </div>
  </div>
</div>