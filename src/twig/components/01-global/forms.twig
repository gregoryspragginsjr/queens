<form class="form" action="#">
  <div class="input-block">
    <div class="input-wrap">
      <label class="label" for="first-name">First Name*</label>
      <input type="text" id="first-name" placeholder="First Name" />
    </div>
  </div>

  <div class="input-block">
    <div class="input-wrap">
      <label class="label" for="last-name">Last Name*</label>
      <input type="text" id="last-name" placeholder="Last Name" />
    </div>
  </div>

  <div class="input-block">
    <div class="input-wrap">
      <label class="label" for="email">Email*</label>
      <input type="email" id="email" placeholder="Email Address" />
      <span class="input-block__text validation-message">Please enter a valid email</span>
    </div>
  </div>

  <div class="input-block">
    <div class="input-wrap">
      <label class="label" for="phone">Phone</label>
      <input type="tel" id="phone" placeholder="Phone Number" />
    </div>
  </div>

  <div class="input-block">
    <label class="label">Birthdate</label>
    <div class="input-block__inner">
      <div class="input-wrap input-wrap--select">
        <select name="birthdate-month" id="birthdate-month">
          <option value="" selected></option>
          <option value="lorem">January</option>
          <option value="ipsum">February</option>
          <option value="dolor">March</option>
        </select>
      </div>

      <div class="input-wrap input-wrap--select">
        <select name="birthdate-day" id="birthdate-day">
          <option value="" selected></option>
          <option value="lorem">01</option>
          <option value="ipsum">02</option>
          <option value="dolor">03</option>
        </select>
      </div>

      <div class="input-wrap input-wrap--select">
        <select name="birthdate-year" id="birthdate-year">
          <option value="" selected></option>
          <option value="lorem">2000</option>
          <option value="ipsum">1999</option>
          <option value="dolor">1998</option>
        </select>
      </div>
    </div>
  </div>

  <div class="input-block">
    <label class="label" for="select-type">I will be attending as a</label>
    <div class="input-wrap input-wrap--select">
      <select name="type" id="select-type">
        <option disabled selected value="">Select an option</option>
        <option value="lorem">Option A</option>
        <option value="ipsum">Option B</option>
        <option value="dolor">Option C</option>
      </select>
    </div>
  </div>

  <div class="input-block">
    <fieldset>
      <legend>May Queens send you text message(s) regarding your college search?</legend>

      <div class="input-wrap input-wrap--inline input-wrap--choice">
        <input type="radio" id="option1" name="options" value="option1" />
        <label for="option1">Option 1</label>
      </div>

      <div class="input-wrap input-wrap--inline input-wrap--choice">
        <input type="radio" id="option2" name="options" value="option2" />
        <label for="option2">Option 2</label>
      </div>

      <div class="input-wrap input-wrap--inline input-wrap--choice">
        <input type="radio" id="option3" name="options" value="option3" />
        <label for="option3">Option 3</label>
      </div>
    </fieldset>
  </div>

  <div class="input-block">
    <div class="input-wrap">
      <label class="label" for="message">Message</label>
      <textarea name="message" id="message" cols="20" rows="5"></textarea>
    </div>
  </div>

  <div class="input-block">
    <fieldset>
      <legend>Would you like to sign up for our newsletter?</legend>

      <div class="input-wrap input-wrap--inline input-wrap--choice">
        <input type="checkbox" id="subscribe" name="subscribe" checked />
        <label for="subscribe">Subscribe</label>
      </div>
    </fieldset>
  </div>

  <div class="input-block">
    <button type="submit" class="btn btn--dark">Submit</button>
  </div>
</form>
