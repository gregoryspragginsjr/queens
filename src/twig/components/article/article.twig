{% import "macros.twig" as macros %}

{% if in_component_library %}
  {% set context = '@context' %}
{% else %}
  {% set context = 'context.twig' %}
{% endif %}

<article class="article article--break-{{ break|default('default') }}">
  {% if image %}
    <div class="article__image">
      {{ macros.picture(
        'w-full object-cover',
        image.srcset,
        image.src,
        image.sizes.desktop,
        image.sizes.mobile,
        image.alt,
        in_component_library
      ) }}
    </div>
  {% endif %}
  {% include context with {
    type: type,
    size: size,
    align: 'left',
    squiggle: squiggle,
    subheading: subheading,
    heading: heading,
    paragraphs: paragraphs,
    buttons: buttons,
  }  %}
</article>