{% import 'macros.twig' as macros %}

{% if in_component_library %}
  {% set context = '@context' %}
  {% set videoComponent = '@video' %}
{% else %}
  {% set context = 'context.twig' %}
  {% set videoComponent = 'video.twig' %}
{% endif %}

<component
  is="media-context"
  class="media-context media-context--{{ type|default('light') }} {{ reverse ? 'media-context--reverse' }}"
>
  <div class="media-context__inner grid">
    <div class="media-context__context">
      {% include context with {
        type: type == 'dark' ? 'light' : 'dark',
        align: 'left',
        size: size,
        squiggle: squiggle,
        subheading: subheading,
        heading: heading,
        paragraphs: paragraphs,
        buttons: buttons,
      } %}
    </div>
    <div class="media-context__image">
      {% if video.id %}
        {% include videoComponent with video %}
      {% elseif collage %}
        <div class="media-context__image-grid">
          <div>
            {% if image_treatment %}
              {{ macros.treatmentPictureNeon(
                'media-context__img--0',
                images[0].image.srcset,
                images[0].image.sizes.Collage_rectangle,
                '382 274',
                image.alt,
                in_component_library
              ) }}
            {% else %}
              {{ macros.picture(
                'media-context__img--0',
                images[0].image.srcset,
                images[0].image.src,
                images[0].image.sizes.Collage_rectangle,
                images[0].image.sizes.Collage_rectangle,
                images[0].image.alt,
                in_component_library
              ) }}
            {% endif %}
            {{ macros.picture(
              'media-context__img--2',
              images[1].image.srcset,
              images[1].image.src,
              images[1].image.sizes.Collage_rectangle,
              images[1].image.sizes.Collage_rectangle,
              images[1].image.alt,
              in_component_library
            ) }}
          </div>
          <div>
            {% if image_treatment %}
              {{ macros.treatmentPictureNeon(
                'media-context__img--3',
                images[2].image.srcset,
                images[2].image.sizes.Collage_portrait,
                '245 345',
                image.alt,
                in_component_library
              ) }}
            {% else %}
              {{ macros.picture(
                'media-context__img--3',
                images[2].image.srcset,
                images[2].image.src,
                images[2].image.sizes.Collage_portrait,
                images[2].image.sizes.Collage_portrait,
                images[2].image.alt,
                in_component_library
              ) }}
            {% endif %}
          </div>
        </div>
      {% else %}
        {{ macros.picture(
          'media-context__img',
          image.srcset,
          image.src,
          image.sizes.Rectangle,
          image.sizes.Rectangle_mobile,
          image.alt,
          in_component_library
        ) }}
      {% endif %}
    </div>
  </div>
</component>