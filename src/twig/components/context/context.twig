{% if in_component_library %}
  {% set buttonGroup = '@button-group' %}
  {% set squiggleComponent = '@squiggle' %}
{% else %}
  {% set buttonGroup = 'button-group.twig' %}
  {% set squiggleComponent = 'squiggle.twig' %}
{% endif %}

<component is="context" class="context context--{{ size|default('medium') }} context--{{ type|default('dark') }} {% if align == 'center' %}text-center{% endif %}">
  {% if subheading %}
    <div class="context__subheading">{{ subheading }}</div>
  {% endif %}
  {% if heading %}
    <h2 class="context__heading{% if type == 'primary' %} text-primary{% endif %}"><div>{{ heading }}</div>
      {% if icon %}
        {{ icons.icon(icon, 'context__icon') }}
      {% elseif squiggle %}
        {% include squiggleComponent %}
      {% endif %}
    </h2>
  {% endif %}
  {% if paragraphs %}
    {{ paragraphs|raw }}
  {% endif %}
  {% if buttons %}
    {% if type == 'primary' %}
      {% set type = 'light' %}
    {% endif %}
    {% include buttonGroup with {
      type: type|default('dark'),
      align: align,
      items: buttons,
    } %}
  {% endif %}
</component>