{% import "icons.twig" as icons %}

<div class="pagination">
  <div class="pagination__inner grid">
    {% if prev %}
      <a class="arrow-btn arrow-btn--dark arrow-btn--reversed{% if not prev %} arrow-btn--hidden{% endif %}" href="{{ prev }}">
        Prev
        {{ icons.icon('arrow', 'arrow-btn__svg') }}
      </a>
    {% endif %}
    <ul>
      {% for page in pages %}
        <li class="pagination__item{% if page.active %} pagination__item--active{% endif %}"><a href="{{ page.url }}">{{ loop.index }}</a></li>
      {% endfor %}
    </ul>
    {% if next %}
      <a class="arrow-btn arrow-btn--dark {% if not next %} arrow-btn--hidden{% endif %}" href="{{ next }}">
        Next
        {{ icons.icon('arrow', 'arrow-btn__svg') }}
      </a>
    {% endif %}
  </div>
</div>