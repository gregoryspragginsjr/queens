{% extends "no-vue.twig" %}

{% if (post.meta('menu') != null) and (post.meta('menu') != 'Automatic') %}
  {% set menu_items = fn('wp_get_nav_menu_items', post.meta('menu'))|map(i => {
    title: i.title,
    url: i.url,
  }) %}
{% else %}
  {% set menu_items = alpha_parent.children %}
{% endif %}

{% block content %}
  <div class="page page--with-sidebar page--no-vue">
    <div class="page__inner grid">
      <div class="page__secondary">
        {% include 'sidebar-nav.twig' with {
          heading: alpha_parent.title,
          items: menu_items,
        } %}
      </div>
      <div class="page__main">
        <div class="wysiwyg">
          {{ post.content }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
