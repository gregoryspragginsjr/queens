{% extends "base.twig" %}

{% block content %}
  <div class="page page--with-sidebar">
    {% include 'page-header.twig' with {
      heading: post.title,
      breadcrumbs: true
    } %}
    <div class="page__inner grid">
      <div class="page__secondary">
        {% include 'sidebar-nav.twig' with {
          heading: alpha_parent.title,
          items: alpha_parent.children,
        } %}
      </div>
      <div class="page__main">
        <div class="wysiwyg">
          {{ post.content }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
